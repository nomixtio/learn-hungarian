{
  "name": "learn-hungarian",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source PWA for learning Hungarian with live Soniox speech translation and practice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nomixtio/learn-hungarian.git"
  },
  "license": "MIT",
  "type": "module",
  "overrides": {
    "@cloudflare/workers-types": "^5.20260804.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p test/worker/tsconfig.json --noEmit && vite build",
    "preview": "npm run build && (test -f .dev.vars && cp .dev.vars dist/learn_hungarian/.dev.vars || true) && vite preview",
    "predeploy": "node scripts/bump-version.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:website": "wrangler deploy -c website/wrangler.jsonc",
    "dev:website": "wrangler dev -c website/wrangler.jsonc",
    "cf-typegen": "wrangler types",
    "generate:audio": "tsx --tsconfig tsconfig.scripts.json scripts/generate-audio.ts",
    "generate:audio:female": "tsx --tsconfig tsconfig.scripts.json scripts/generate-audio.ts --female",
    "generate:audio:male": "tsx --tsconfig tsconfig.scripts.json scripts/generate-audio.ts --male",
    "build:audio-catalog": "tsx --tsconfig tsconfig.scripts.json scripts/build-audio-catalog.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:worker": "vitest run --config test/worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:setup": "wrangler d1 migrations apply learn-hungarian --local",
    "test:all": "npm run test && npm run test:worker",
    "alchemy:plan": "alchemy plan",
    "deploy:staging": "npm run build && alchemy deploy --stage staging",
    "deploy:production": "npm run build && alchemy deploy --stage production",
    "destroy:preview": "alchemy destroy"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "@soniox/client": "^2.3.0",
    "@soniox/react": "^2.1.0",
    "@tanstack/react-router": "^1.170.18",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "alchemy": "2.0.0-beta.77",
    "effect": "4.0.0-rc.112",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  },
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/nomixtio/learn-hungarian/issues"
  },
  "homepage": "https://github.com/nomixtio/learn-hungarian#readme"
}
